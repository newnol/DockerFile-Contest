direction: right
vars: { d2-config: { sketch: false; theme-id: 0 } }
classes: { node: { width: 260; height: 100; style: { fill: "#eeebe3"; stroke: "#c9c9bf"; font-color: "#69716b"; font-size: 26; border-radius: 12; stroke-width: 2 } } }
a: "Container" { class: node }
b: "/health/ JSON" { class: node }
b.style: { fill: "#e4ece3"; stroke: "#37775e"; font-color: "#252827"; stroke-width: 4 }
c: "Homepage" { class: node }
c.style: { fill: "#e4ece3"; stroke: "#37775e"; font-color: "#252827"; stroke-width: 4 }
d: "Coffee stub /hot" { class: node }
d.style: { fill: "#e4ece3"; stroke: "#37775e"; font-color: "#252827"; stroke-width: 4 }
a -> b: { style: { stroke: "#9b9f95"; stroke-width: 3 } }
a -> c: { style: { stroke: "#9b9f95"; stroke-width: 3 } }
c -> d: { style: { stroke: "#9b9f95"; stroke-width: 3 } }
