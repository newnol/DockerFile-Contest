direction: right
vars: { d2-config: { sketch: false; theme-id: 0 } }
classes: { node: { width: 260; height: 100; style: { fill: "#eeebe3"; stroke: "#c9c9bf"; font-color: "#69716b"; font-size: 26; border-radius: 12; stroke-width: 2 } } }
a: "python:3.13-slim" { class: node }
b: "Thời điểm T1" { class: node }
c: "Thời điểm T2" { class: node }
d: "Nội dung A" { class: node }
d.style: { fill: "#f4e5da"; stroke: "#bd583e"; font-color: "#bd583e"; stroke-width: 4 }
e: "Nội dung B" { class: node }
e.style: { fill: "#f4e5da"; stroke: "#bd583e"; font-color: "#bd583e"; stroke-width: 4 }
a -> b: { style: { stroke: "#9b9f95"; stroke-width: 3 } }
a -> c: { style: { stroke: "#9b9f95"; stroke-width: 3 } }
b -> d: { style: { stroke: "#9b9f95"; stroke-width: 3 } }
c -> e: { style: { stroke: "#9b9f95"; stroke-width: 3 } }
