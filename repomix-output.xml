# syntax=docker/dockerfile:1.7

# =============================================================================
# DOCKERFILE DISTROLESS PYTHON3 - PRODUCTION READY
# 
# Build và runtime đều dùng Python 3.11 để đảm bảo binary compatibility
# - Build stage: python:3.11-slim
# - Runtime: gcr.io/distroless/python3-debian12 (Python 3.11)
# - 100% binary compatible, không có compatibility issues
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Dependencies Builder (Python 3.11 để match distroless)
# -----------------------------------------------------------------------------
    FROM python:3.11-slim AS deps

    ENV PIP_NO_CACHE_DIR=1 \
        PIP_DISABLE_PIP_VERSION_CHECK=1 \
        PYTHONDONTWRITEBYTECODE=1 \
        PYTHONUNBUFFERED=1
    
    # Install build dependencies
    RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        python3.11-dev \
        cargo \
        && rm -rf /var/lib/apt/lists/*
    
    # Install dependencies với PATCHED versions để fix CVEs
    RUN --mount=type=cache,target=/root/.cache/pip \
        python -m pip install --no-cache-dir --prefix=/install \
             "aiohttp>=3.12.14,<4.0.0" \
             "asgi-correlation-id>=4.3.4,<5.0.0" \
             "fastapi>=0.116.0" \
             "prometheus-fastapi-instrumentator>=7.0.0,<8.0.0" \
             "pydantic>=2.11.0,<3.0.0" \
             "pydantic-settings>=2.9.1,<3.0.0" \
             "structlog>=25.3.0,<26.0.0" \
             "uvloop>=0.21.0,<0.22.0" \
             "uvicorn>=0.30.0,<0.31.0"
    
    # ULTRA AGGRESSIVE optimization
    RUN apt-get update && apt-get install -y --no-install-recommends binutils \
     && find /install -type f \( -name '*.so*' -o -name '*.a' \) -exec strip --strip-all {} + 2>/dev/null || true \
     && find /install \( -type d -name __pycache__ -o -type f -name '*.py[co]' \) -delete 2>/dev/null || true \
     && find /install -type d \( -name tests -o -name testing -o -name test -o -name doc -o -name docs -o -name example -o -name examples \) -prune -exec rm -rf {} + 2>/dev/null || true \
     && find /install -name '*.dist-info' -type d -exec sh -c 'cd "$1" && find . -type f ! -name "METADATA" ! -name "top_level.txt" ! -name "RECORD" -delete' _ {} \; 2>/dev/null || true \
     && find /install -type f \( -name '*.pyi' -o -name '*.c' -o -name '*.h' -o -name '*.cpp' -o -name '*.cc' \) -delete \
     && find /install -type f \( -name 'LICENSE*' -o -name 'COPYING*' -o -name 'NOTICE*' -o -name 'AUTHORS*' -o -name 'CHANGELOG*' -o -name 'README*' \) -delete 2>/dev/null || true \
     && apt-get purge -y binutils \
     && apt-get autoremove -y \
     && rm -rf /var/lib/apt/lists/*
    
    # -----------------------------------------------------------------------------
    # Stage 2: Distroless Python3 Runtime (Python 3.11)
    # -----------------------------------------------------------------------------
    FROM gcr.io/distroless/python3-debian12:nonroot AS runtime
    
    LABEL org.opencontainers.image.title="Python Service Template" \
          org.opencontainers.image.description="Production-ready FastAPI service - Distroless Python3 Optimized & Secured" \
          org.opencontainers.image.version="0.1.0" \
          org.opencontainers.image.authors="newnol <contact@newnol.io.vn>" \
          maintainer="newnol" \
          security.scan="trivy-passed"
    
    ENV PYTHONDONTWRITEBYTECODE=1 \
        PYTHONUNBUFFERED=1 \
        PIP_NO_CACHE_DIR=1 \
        HOST=0.0.0.0 \
        PORT=5000 \
        WORKERS=1 \
        PYTHONPATH=/app/src \
        TZ=UTC
    
    WORKDIR /app
    
    # Copy dependencies (Python 3.11 -> Python 3.11, perfect match!)
    COPY --from=deps --chown=nonroot:nonroot /install/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
    
    # Copy source code
    COPY --chown=nonroot:nonroot src/ ./src/
    
    EXPOSE 5000
    
    # Healthcheck using Python built-in
    HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=2 \
        CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/health/')"]
    
    STOPSIGNAL SIGTERM
    
    # Python 3.11 của distroless
    CMD ["python3", "src/python_service_template/app.py"]
</file>

